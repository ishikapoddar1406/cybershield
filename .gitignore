# Dependencies
node_modules/
*/node_modules/

# Environment files & Secrets
.env
.env.local
.env.*.local
server/.env
client/.env

# Runtime Database & WAL files (seeded via npm run seed)
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/*.sqlite
server/data/*.sqlite3

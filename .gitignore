# Uploaded runtime evidence files (test samples remain in samples/)
server/storage/evidence/*
!server/storage/evidence/.gitkeep

# Production builds
dist/
client/dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor artifacts
.DS_Store
Thumbs.db
